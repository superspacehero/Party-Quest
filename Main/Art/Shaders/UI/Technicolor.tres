code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D screen_tex_frg_2 : hint_screen_texture;



void fragment() {
// Input:30
	vec2 n_out30p0 = SCREEN_UV;
	float n_out30p1 = n_out30p0.r;


	vec4 n_out2p0;
// Texture2D:2
	n_out2p0 = texture(screen_tex_frg_2, n_out30p0);
	float n_out2p1 = n_out2p0.r;
	float n_out2p2 = n_out2p0.g;
	float n_out2p3 = n_out2p0.b;


// FloatOp:62
	float n_out62p0 = n_out2p1 - n_out2p2;


// FloatOp:61
	float n_out61p0 = n_out62p0 + n_out2p1;


// FloatOp:63
	float n_out63p0 = n_out61p0 - n_out2p3;


// FloatOp:60
	float n_out60p0 = n_out2p2 - n_out2p3;


// FloatOp:59
	float n_out59p0 = n_out60p0 + n_out2p2;


// FloatOp:58
	float n_out58p0 = n_out59p0 - n_out2p1;


// FloatOp:55
	float n_out55p0 = n_out2p3 - n_out2p1;


// FloatOp:56
	float n_out56p0 = n_out55p0 + n_out2p3;


// FloatOp:57
	float n_out57p0 = n_out56p0 - n_out2p2;


// VectorCompose:31
	vec3 n_out31p0 = vec3(n_out63p0, n_out58p0, n_out57p0);


// FloatConstant:65
	float n_out65p0 = 0.200000;


// Mix:64
	vec3 n_out64p0 = mix(vec3(n_out2p0.xyz), n_out31p0, vec3(n_out65p0));


// Output:0
	COLOR.rgb = n_out64p0;


}
